# Vercel Production environment variables (private — no NEXT_PUBLIC_ prefix)
# Project Settings → Environment Variables → Production
#
# Replace YOUR_RENDER_SERVICE with your Render web service host.

API_URL=https://YOUR_RENDER_SERVICE.onrender.com/api
SOCKET_URL=https://YOUR_RENDER_SERVICE.onrender.com

# REST calls go through /api/backend on this Next.js app (server proxy).
# Socket URL is served at runtime via /api/runtime-config for the admin realtime feed.
#
# After deploy, add the Vercel URL to backend CORS_ORIGINS on Render:
# CORS_ORIGINS=https://your-project.vercel.app
