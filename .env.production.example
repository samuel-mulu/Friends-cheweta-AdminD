# Vercel Production environment variables
# Project Settings → Environment Variables → Production
#
# Replace YOUR_RENDER_SERVICE with your Render web service host, e.g. friends-game-api.onrender.com

NEXT_PUBLIC_API_URL=https://YOUR_RENDER_SERVICE.onrender.com/api
NEXT_PUBLIC_SOCKET_URL=https://YOUR_RENDER_SERVICE.onrender.com
NEXT_PUBLIC_APP_NAME=Friends Game Hub

# After setting these, add the Vercel URL to backend CORS_ORIGINS on Render:
# CORS_ORIGINS=https://your-project.vercel.app
