# Copy to .env on the VPS. Compose reads this file. Do not commit .env.
# Both values are server-only. They are not baked into the browser bundle.

# NestJS origin plus the global /api prefix. The browser calls /api/backend on this app;
# the Next.js server proxies that path here.
API_URL=https://api.friendschewata.io/api

# Socket.IO origin, without /api and without /game.
# The browser loads this at runtime from GET /api/runtime-config and connects to /game.
SOCKET_URL=https://api.friendschewata.io

# Set by compose.prod.yml. Listed so a hand-written env file stays complete.
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
